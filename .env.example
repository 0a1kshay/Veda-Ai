# Server-side Gemini API Configuration (DO NOT expose via NEXT_PUBLIC_)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Optional model selection (default: gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# Optional comma-separated fallback models available to your API account
# GEMINI_FALLBACK_MODELS=another-available-model
